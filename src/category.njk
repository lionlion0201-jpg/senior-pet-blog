---
layout: base.njk
pagination:
  data: collections.categoryHubs
  size: 1
  alias: cat
permalink: "/category/{{ cat.slug }}/"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ cat.name | safe }}の記事一覧"
  description: "{{ cat.intro | safe }}"
---
{#- テーマ別のまとめページ。テーマと記事の対応は src/_data/categories.json、
    掲載するのは公開済みの記事だけ(.eleventy.js の categoryHubs コレクション)。 -#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ site.name | dump | safe }}, "item": "{{ site.domain }}{{ '/' | url }}" },
    { "@type": "ListItem", "position": 2, "name": {{ cat.name | dump | safe }}, "item": "{{ site.domain }}{{ page.url | url }}" }
  ]
}
</script>
<nav class="breadcrumb" aria-label="パンくずリスト">
  <a href="{{ '/' | url }}">ホーム</a> <span aria-hidden="true">›</span> {{ cat.name }}
</nav>
<h1>{{ cat.name }}</h1>
<p class="category-intro">{{ cat.intro }}</p>

<ul class="post-list">
{% for post in cat.posts %}
  <li class="post-card">
    <span class="post-meta">{{ post.date | readableDate }}</span>
    <h2><a href="{{ post.url | url }}">{{ post.data.title }}</a></h2>
    <p>{{ post.data.description }}</p>
  </li>
{% endfor %}
</ul>

<nav class="category-nav" aria-label="ほかのテーマ">
  <h2>ほかのテーマ</h2>
  <ul>
  {% for other in collections.categoryHubs %}{% if other.slug != cat.slug %}
    <li><a href="{{ ('/category/' + other.slug + '/') | url }}">{{ other.name }}<span class="count">{{ other.posts.length }}</span></a></li>
  {% endif %}{% endfor %}
  </ul>
</nav>
