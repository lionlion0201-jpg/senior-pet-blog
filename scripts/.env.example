# X (Twitter) API v2 - OAuth 1.0a user context credentials
# このファイルをコピーして「.env」という名前で同じフォルダに保存し、
# ご自身のXアカウント(国内アフィ用、米国版とは別アカウント)の値を入力してください。
# .env は .gitignore 済みなので、git commit / push されることはありません。
#
# 取得方法:
# 1. https://developer.x.com/ でDeveloperアカウント登録(このプロジェクト専用のXアカウントで)
# 2. プロジェクト/アプリを作成し、「User authentication settings」で
#    Read and Write権限を有効にする
# 3. 「Keys and tokens」から以下の4つを発行する
#    - API Key / API Key Secret (Consumer Keys)
#    - Access Token / Access Token Secret (Read and Write権限で再生成が必要な場合あり)

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 1回の実行で投稿できる上限(誤爆防止の安全弁、任意)
MAX_POSTS_PER_RUN=6
