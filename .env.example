# このファイルをコピーして .env を作り、値を埋めること。
#   cp .env.example .env
# .env は .gitignore に入っているのでコミットされない。
#
# 実際の投稿・メトリクス取得は GitHub Actions 上で動くため、本番で使う値は
# リポジトリの Settings → Secrets and variables → Actions にも登録が必要。
# ここの .env は手元で動作確認するとき用。

# X (Twitter) API v2 -- OAuth 1.0a user context
# 投稿(post_scheduled_tweets.py)とメトリクス取得(fetch_tweet_metrics.py)の両方で使う。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 自分の数値ユーザーID(任意)。
# メトリクス取得時、未設定だと毎回 GET /2/users/me を呼んで約$0.01かかる。
# GitHub Actions では Variables に X_USER_ID として登録しておくと節約できる
# (秘密情報ではないので Secrets ではなく Variables でよい)。
X_USER_ID=

# 1回の実行で投稿してよい上限。Xは従量課金なので、暴走時の歯止めとして効かせている。
MAX_POSTS_PER_RUN=6
